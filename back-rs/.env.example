# ==========================================================
#  Refleja API (Rust) — plantilla de configuración. Copia a .env (NO se versiona).
#  Mismos nombres de variables que el backend Python (back/.env.example).
#  En producción el servicio NO arranca con secretos por defecto o de <32 caracteres.
# ==========================================================
ENV=production
APP_HOST=127.0.0.1
APP_PORT=20832

# MariaDB. Se acepta el formato del backend Python (mysql+pymysql://) o mysql://
DATABASE_URL=mysql://refleja:TU_PASSWORD@127.0.0.1:3306/refleja
# Opcional: máximo de conexiones del pool (default 10)
# DB_MAX_CONNECTIONS=10
# Opcional: hashes Argon2id simultáneos (cada uno usa 64 MiB; default 1)
# ARGON2_CONCURRENCY=1

CORS_ORIGINS=https://refleja.org,https://www.refleja.org

# Genera cada uno con:  openssl rand -hex 48
JWT_SECRET=GENERA_UNO
PUBLIC_TOKEN_SECRET=GENERA_OTRO
VID_HMAC_KEY=GENERA_OTRO_MAS

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
PUBLIC_TOKEN_TTL_DAYS=30

TURNSTILE_SECRET_LOGIN=
TURNSTILE_SECRET_INVISIBLE=
DEV_BYPASS_TURNSTILE=false

COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

ORIGIN_SECRET=
ORIGIN_SECRET_HEADER=X-Origin-Secret

# Ruta a formulario.json (vacío = ../front/src/formulario.json relativo al directorio de trabajo)
FORMULARIO_PATH=

# Anti-abuso (valores por defecto)
# COLLECT_RATE_PER_MIN=120
# SESSION_RATE_PER_MIN=30
# PING_RATE_PER_MIN=30
# PUBLIC_MAX_EVENTS=2000
# PUBLIC_MAX_RUNS=20
# PUBLIC_MAX_ACTIONS=300
