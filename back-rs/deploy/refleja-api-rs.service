# /etc/systemd/system/refleja-api-rs.service
# Servicio de la API de Refleja en Rust (reemplaza a refleja-api.service de FastAPI).
# Copia a /etc/systemd/system/ y ajusta las rutas si difieren. Ver deploy/README.md.
[Unit]
Description=Refleja API (Rust/Axum)
After=network.target mariadb.service

[Service]
Type=simple
User=refleja-api
Group=refleja-api
# El proceso lee .env del WorkingDirectory y ../front/src/formulario.json (mismo checkout que el backend Python).
WorkingDirectory=/home/refleja-api/htdocs/api.refleja.org/back-rs
ExecStart=/home/refleja-api/htdocs/api.refleja.org/back-rs/bin/refleja-api
Environment=RUST_LOG=info
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Tope de seguridad de memoria (opcional; ajusta tras medir en producción)
# MemoryMax=256M
# Logs a journald (journalctl -u refleja-api-rs.service)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
